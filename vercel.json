{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/registro",
      "has": [
        {
          "type": "query",
          "key": "ref"
        }
      ],
      "destination": "/trad/registro",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/trad/api/:path*",
      "destination": "https://qlcsw-b.onrender.com/trad/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://qlcsw-b.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets/|brand/|guides/|favicon\\.png|version\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/((?!assets/|version\\.json|api/|trad/api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
